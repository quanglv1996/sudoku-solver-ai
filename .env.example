# Sao chép thành .env và chỉnh nếu cần (mọi biến đều có giá trị mặc định trong config.py)

# --- Server ---
SERVER_HOST=0.0.0.0
HTTP_PORT=5000
# Điện thoại chỉ cho mở camera qua HTTPS → server tự sinh chứng chỉ tự ký trong certs/
HTTPS_ENABLED=true
HTTPS_PORT=5443
CORS_ORIGINS=*
# IP LAN của máy (bắt buộc khi chạy Docker để điện thoại truy cập đúng địa chỉ), vd. 192.168.1.118
PUBLIC_HOSTS=
LOG_LEVEL=INFO

# --- Model ---
POINT_MODEL_PATH=backend/weights/best.pt
POINT_CONF=0.25
# cuda / cpu / auto
DEVICE=auto
OCR_MODEL_NAME=PP-OCRv6_medium_rec
OCR_CONF_THRESHOLD=0.5
CELL_SIZE=64

# --- Hàng đợi ---
MAX_QUEUE=32
# Giây giữ kết quả job trước khi dọn
JOB_TTL=600
REALTIME_TIMEOUT=5
# Timeout của /api/solve (đồng bộ)
SYNC_TIMEOUT=120

# --- Ảnh ---
MAX_FILE_SIZE=15728640
MAX_IMAGE_SIZE=1280
REALTIME_MAX_SIZE=800

# --- Chế độ Màn hình PC (điều khiển chuột/bàn phím của máy server) ---
SCREEN_CONTROL=true
# true: chỉ cho kích hoạt từ chính máy server
SCREEN_LOCAL_ONLY=false

# --- Debug ---
SAVE_DEBUG=false
DEBUG_DIR=debug_output
