# .env.example
# Copy this file to .env and customize the values
# Sao chép tập tin này thành .env và tùy chỉnh giá trị

# =====================================================================
# Server Configuration
# =====================================================================

# Flask environment (development/production)
FLASK_ENV=development

# Server host
SERVER_HOST=0.0.0.0

# Server port
SERVER_PORT=5000

# CORS origins (use * for all, or specific domains)
CORS_ORIGINS=*

# =====================================================================
# Model Configuration
# =====================================================================

# Path to YOLO point detection model
POINT_MODEL_PATH=backend/weights/best.pt

# Device for inference (cuda/cpu)
DEVICE=cpu

# =====================================================================
# OCR Configuration
# =====================================================================

# EasyOCR language
OCR_LANG=en

# Use GPU for OCR (true/false)
OCR_GPU=false

# Confidence threshold for OCR
OCR_CONF_THRESHOLD=0.3

# =====================================================================
# File Upload Configuration
# =====================================================================

# Maximum file size in bytes (10MB default)
MAX_FILE_SIZE=10485760

# Maximum image size for processing in pixels
MAX_IMAGE_SIZE=800

# =====================================================================
# Pipeline Configuration
# =====================================================================

# Cell size for grid preprocessing
CELL_SIZE=64

# Verbose logging (true/false)
VERBOSE=false

# =====================================================================
# Timeout Configuration
# =====================================================================

# Request timeout in seconds
REQUEST_TIMEOUT=60

# Processing timeout in seconds
PROCESSING_TIMEOUT=120

# =====================================================================
# Logging Configuration
# =====================================================================

# Log level (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=sudoku_solver.log

# =====================================================================
# Feature Flags
# =====================================================================

# Enable result caching (true/false)
CACHE_RESULTS=false

# Enable result download (true/false)
ENABLE_DOWNLOAD=true

# =====================================================================
# Display Configuration
# =====================================================================

# UI Theme (dark/light)
UI_THEME=dark

# Page title
PAGE_TITLE=Sudoku Solver AI - High Tech

# Page subtitle
PAGE_SUBTITLE=Upload a sudoku image, let AI solve it instantly
